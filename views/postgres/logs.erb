<div class="p-6">
  <div class="md:flex md:items-center md:justify-between pb-2 lg:pb-4">
    <div class="min-w-0 flex-1">
      <h3 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-2xl sm:tracking-tight">
        Log Destinations
      </h3>
    </div>
  </div>
  <div class="overflow-x-auto rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white divide-y divide-gray-200">
    <table class="min-w-full divide-y divide-gray-300">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Host</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Port</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @pg.log_destinations.each do |ld| %>
          <tr>
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= ld.name %></td>
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= ld.host %></td>
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= ld.port %></td>
            <td
              id="ld-delete-<%= ld.ubid %>"
              class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6"
            >
              <%== part("components/delete_button", url: "#{path(@pg)}/log-destination/#{ld.ubid}", text: "") %>
            </td>
          </tr>
        <% end %>
        <% if @pg.log_destinations.empty? %>
          <tr>
            <td colspan="4" class="py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6">No log destinations configured.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @edit_perm %>
  <div class="p-6">
    <div class="md:flex md:items-center md:justify-between pb-2 lg:pb-4">
      <div class="min-w-0 flex-1">
        <h3 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-2xl sm:tracking-tight">
          Add Log Destination
        </h3>
      </div>
    </div>
    <div class="overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white divide-y divide-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <% form(action: "#{path(@pg)}/log-destination", method: :post) do %>
          <div class="space-y-4">
            <div class="grid grid-cols-12 gap-6">
              <div class="col-span-12 sm:col-span-4">
                <%== part("components/form/text", name: "name", label: "Name", attributes: { required: true }) %>
              </div>
              <div class="col-span-12 sm:col-span-5">
                <%== part("components/form/text", name: "host", label: "Host", attributes: { required: true }) %>
              </div>
              <div class="col-span-12 sm:col-span-3">
                <%== part("components/form/text", name: "port", label: "Port", type: "number", attributes: { required: true, min: 1, max: 65535 }) %>
              </div>
            </div>
            <div class="grid grid-cols-12 gap-6">
              <div class="col-span-12 sm:col-span-9">
                <%== part(
                  "components/form/text",
                  name: "structured_data_json",
                  label: "Structured Data (optional JSON)",
                  attributes: { placeholder: '{"honeybadger@61642":{"api_key":"your-key"}}' }
                ) %>
              </div>
              <div class="col-span-12 sm:col-span-3 flex justify-end items-end">
                <%== part("components/form/submit_button", text: "Add", extra_class: "log-destination-create-button") %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
